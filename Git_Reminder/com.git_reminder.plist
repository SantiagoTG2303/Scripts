<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.git_reminder</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/Scripts/Git_Reminder/.venv/bin/python3</string>
        <string>/Users/YOUR_USERNAME/Scripts/Git_Reminder/GitChecker.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/Scripts/Git_Reminder</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Scripts/Git_Reminder/launchagent.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Scripts/Git_Reminder/launchagent.err.log</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
